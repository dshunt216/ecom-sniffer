# =============================================================
# Ecomm Sniffer — Environment Variables
# Copy this file to .env.local (frontend) and .env (workers)
# NEVER commit real values to git
# =============================================================

# Supabase (get from: Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...    # Workers ONLY, never expose to frontend

# Anthropic Claude API (get from: console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Reddit (get from: reddit.com/prefs/apps — create "script" type app)
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USER_AGENT=ecomm-sniffer/1.0 by /u/your_username

# TwitterAPI.io (get from: twitterapi.io dashboard)
TWITTER_API_KEY=your_api_key

# Cron schedules (Railway only — set in Railway dashboard)
CRON_SCHEDULE_INGESTION=*/30 * * * *
CRON_SCHEDULE_BRIEFING=0 11 * * *
